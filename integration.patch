+import type { InterviewPresentation as ReviewedPresentation } from "@/lib/ai/presentation-schema";
+import type { ImageAnalysisResult as ReviewedImage } from "@/lib/ai/image-analysis";
+import type { InterviewPresentation } from "@/types/presentation";
+import type { ImageAnalysisResult } from "@/types/interview-generation";
+
+/** Preserve the existing editor contract; retain richer originals as review metadata. */
+export function toEditorPresentation(deck: ReviewedPresentation): InterviewPresentation {
+  return { title: deck.title, slides: deck.slides.map(({ heading, bullets, speakerNotes, sourceIds, imageIds }) => ({
+    heading, bullets: [...bullets], speakerNotes, sourceIds: [...sourceIds], imageIds: [...imageIds],
+  })) };
+}
+export function toEditorImageAnalyses(images: ReviewedImage[]): ImageAnalysisResult[] {
+  return images.map(image => ({ ...image, relevantSkills: [] }));
+}
diff --git a/src/lib/storage/image-decode.ts b/src/lib/storage/image-decode.ts
new file mode 100644
index 0000000000000000000000000000000000000000..091f1fedefced7d0aae8ed005044585bfa3f6acd
--- /dev/null
+++ b/src/lib/storage/image-decode.ts
@@ -0,0 +1,17 @@
+import sharp from "sharp";
+import { inspectImage, type InspectionResult } from "./image-inspection";
+import { MAX_IMAGE_BYTES, MAX_IMAGE_PIXELS } from "@/lib/validation/image-schema";
+/** Header limits first, then full pixel decode with libvips resource limits. Original bytes are preserved. */
+export async function decodeImage(bytes:Uint8Array):Promise<InspectionResult>{
+  if(bytes.length>MAX_IMAGE_BYTES) return {ok:false,error:"Image must be 5 MB or smaller."};
+  const header=inspectImage(bytes);
+  if(!header.ok)return header;
+  try{
+    const decoder=sharp(Buffer.from(bytes),{limitInputPixels:MAX_IMAGE_PIXELS,failOn:"warning",animated:true});
+    const metadata=await decoder.metadata();
+    const frames=metadata.pages??1;
+    if(frames>100 || header.image.width*header.image.height*frames>MAX_IMAGE_PIXELS) return {ok:false,error:"Image frames exceed the 40 megapixel decoding limit."};
+    await decoder.timeout({seconds:10}).raw().toBuffer();
+    return header;
+  }catch{return {ok:false,error:"This image is damaged or incomplete and cannot be decoded. Upload a valid PNG, JPEG, WebP or GIF."};}
+}
