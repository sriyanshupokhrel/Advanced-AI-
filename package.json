{
  "name": "cv-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/prisma-migrate-deploy.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "npm run test:unit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --import ./tests/support/register.mjs \"tests/unit/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:ai-mock": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evaluation/mock-ai.mjs",
    "test:integration": "node --experimental-transform-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/integration/merged-workflow.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@google/genai": "1.52.0",
    "@prisma/client": "6.19.3",
    "jszip": "3.10.1",
    "next": "16.4.2",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
